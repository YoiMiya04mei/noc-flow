# ==============================================================================
# JDP Route Intelligence Platform - Environment Configuration Template
# All production secrets must be generated securely. Do NOT commit live credentials!
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="JDP Route Intelligence Platform"
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=change-this-to-a-very-secure-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Super Admin Bootstrapping (Used only during first-time migration/seed)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@noc.local
INITIAL_ADMIN_PASSWORD=change-me-immediately-upon-first-login

# Database Configurations
# PostgreSQL (Application Metadata, RBAC, Inventory, Audit)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jdp_route_intel
POSTGRES_USER=jdp_user
POSTGRES_PASSWORD=replace_with_strong_pg_password
DATABASE_URL=postgresql+asyncpg://jdp_user:replace_with_strong_pg_password@postgres:5432/jdp_route_intel

# ClickHouse (High-Rate Flow Telemetry & Time-Series Analytics)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=jdp_flow_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace_with_strong_ch_password

# Go Flow Collector Settings
COLLECTOR_HOST=0.0.0.0
COLLECTOR_NETFLOW_PORT=2055
COLLECTOR_SFLOW_PORT=6343
COLLECTOR_IPFIX_PORT=4739
COLLECTOR_BATCH_SIZE=1000
COLLECTOR_BATCH_FLUSH_INTERVAL_MS=1000
COLLECTOR_WORKER_POOL_SIZE=8
COLLECTOR_BUFFER_SIZE=100000

# ==============================================================================
# ROUTING & BGP SAFETY GUARDRAILS (CRITICAL!)
# ==============================================================================
# Under NO circumstances should ROUTING_EXECUTION_ENABLED be set to true on production
ROUTING_EXECUTION_ENABLED=false
PRODUCTION_ROUTING_ENABLED=false
FLOWSPEC_EXECUTION_ENABLED=false
RTBH_EXECUTION_ENABLED=false
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=300
MAX_ROLLOUT_PREFIX_LIMIT=5
DEFAULT_RTBH_COMMUNITY=65535:666
DEFAULT_MITIGATION_TTL_MINUTES=60

# Maximum allowed prefix announcements delta in a single change batch
MAX_PREFIX_CHANGE_LIMIT=10

# ==============================================================================
# PHASE 6: ISOLATED BGP LAB CONFIGURATION
# ==============================================================================
# Keeps lab execution strictly gated. Set to true ONLY in designated testbeds!
BGP_LAB_ENABLED=false
BGP_LAB_SPEAKER_1_HOST=127.0.0.1
BGP_LAB_SPEAKER_1_PORT=50051
BGP_LAB_SPEAKER_1_ASN=65001
BGP_LAB_SPEAKER_2_HOST=127.0.0.1
BGP_LAB_SPEAKER_2_PORT=50052
BGP_LAB_SPEAKER_2_ASN=65002
BGP_LAB_MODE=true

# Demo & Simulation Modes
DEMO_MODE_ENABLED=true
DEMO_TRAFFIC_SIMULATOR_RATE_PPS=500

# Web UI
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
